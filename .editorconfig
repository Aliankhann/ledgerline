root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
ktlint_standard_function-naming = disabled

[*.{ts,tsx,js,json,yml,yaml,md,css,html}]
indent_size = 2
